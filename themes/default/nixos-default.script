# NixOS default Plymouth theme: the logomark winds up and spins on black,
# with a password cursor centered below it.
#
# The frame count and sequence below are filled in at build time
# from render-frames.py output.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

frame_count = @frameCount@;
sequence_length = @sequenceLength@;
@sequence@

screen_x = Window.GetX();
screen_y = Window.GetY();
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
center_x = screen_x + screen_w / 2;
center_y = screen_y + screen_h / 2;

# Logo takes ~22% of the shorter screen side; everything else scales with it.
logo_size = Math.Int(Math.Min(screen_w, screen_h) * 0.22);
if (logo_size < 128)
  logo_size = 128;
ui = logo_size / 256;

for (i = 0; i < frame_count; i++)
  frames[i] = Image("frame-" + i + ".png").Scale(logo_size, logo_size);

logo = Sprite(frames[0]);
logo.SetPosition(center_x - logo_size / 2, center_y - logo_size / 2, 10);

tick = 0;
fun refresh_callback() {
  logo.SetImage(frames[sequence[global.tick]]);
  global.tick = global.tick + 1;
  if (global.tick >= sequence_length)
    global.tick = 0;
  blink_cursor();
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- Password prompt -------------------------------------------------------
# No prompt text or box: a blinking cursor below the logo, with a bullet per
# typed character. The row stays centered and the cursor sits after the last
# bullet.

font = "Sans " + Math.Int(13 * ui);

line_y = center_y + logo_size / 2 + Math.Int(64 * ui);

bullet_size = Math.Int(12 * ui);
bullet_gap = Math.Int(6 * ui);
bullet_image = Image("bullet.png").Scale(bullet_size, bullet_size);
bullet_max = 32;

cursor_w = Math.Max(2, Math.Int(3 * ui));
cursor_h = Math.Int(24 * ui);
cursor = Sprite(Image("cursor.png").Scale(cursor_w, cursor_h));
cursor.SetY(line_y - cursor_h / 2);
cursor.SetZ(30);
cursor.SetOpacity(0);

password_active = 0;
blink_tick = 0;
blink_ticks = 27; # ~0.53 s at 50 Hz, like a terminal cursor

bullets_shown = 0;

fun set_bullets(count) {
  if (count > bullet_max)
    count = bullet_max;
  step = bullet_size + bullet_gap;
  row_w = count * step + cursor_w;
  x = center_x - row_w / 2;
  for (i = 0; i < count; i++) {
    if (!global.bullets[i])
      global.bullets[i] = Sprite(bullet_image);
    global.bullets[i].SetPosition(x + i * step, line_y - bullet_size / 2, 30);
    global.bullets[i].SetOpacity(1);
  }
  for (i = count; i < global.bullets_shown; i++)
    global.bullets[i].SetOpacity(0);
  global.bullets_shown = count;
  cursor.SetX(x + count * step);
}

fun display_password_callback(prompt_text, bullet_count) {
  global.password_active = 1;
  global.blink_tick = 0;  # keep the cursor solid while typing
  cursor.SetOpacity(1);
  set_bullets(bullet_count);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
  global.password_active = 0;
  cursor.SetOpacity(0);
  set_bullets(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun blink_cursor() {
  if (!global.password_active)
    return;
  global.blink_tick = global.blink_tick + 1;
  if (global.blink_tick >= 2 * blink_ticks)
    global.blink_tick = 0;
  if (global.blink_tick < blink_ticks)
    cursor.SetOpacity(1);
  else
    cursor.SetOpacity(0);
}

# --- Messages --------------------------------------------------------------

message = Sprite();
message.SetZ(20);

fun message_callback(text) {
  image = Image.Text(text, 0.6, 0.6, 0.6, 1, font);
  message.SetImage(image);
  message.SetPosition(center_x - image.GetWidth() / 2, line_y + Math.Int(40 * ui), 20);
}
Plymouth.SetMessageFunction(message_callback);
